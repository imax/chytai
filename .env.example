# Electron on the Mac reads only ANTHROPIC_API_KEY. The web server (server/index.js) also needs:
ANTHROPIC_API_KEY=sk-ant-…
# One password for the whole family; each person types their own name at login.
READER_PASSWORD=
# Signs the login cookie. Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
READER_SECRET=
# Where books and reading positions live (default ./data; /data on Fly)
#DATA_DIR=./data
