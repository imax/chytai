{
  "name": "chytai-mac",
  "productName": "Chytai",
  "version": "1.0.0",
  "description": "Читалка Chytai для Mac",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ua.org.chytai.reader",
    "productName": "Chytai",
    "copyright": "Chytai",
    "files": ["main.js", "icon.png"],
    "mac": {
      "category": "public.app-category.books",
      "icon": "icon.png",
      "hardenedRuntime": true,
      "target": [{ "target": "dmg", "arch": ["universal"] }]
    },
    "dmg": {
      "title": "Chytai",
      "artifactName": "Chytai-${version}.dmg"
    }
  }
}
